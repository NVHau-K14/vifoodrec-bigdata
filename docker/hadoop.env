# Cau hinh Hadoop cho image apache/hadoop (dang FILE_property=value,
# image tu chuyen thanh core-site.xml / hdfs-site.xml khi khoi dong)

CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
CORE-SITE.XML_fs.default.name=hdfs://namenode:8020

HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
HDFS-SITE.XML_dfs.namenode.name.dir=/tmp/hadoop-root/dfs/name
HDFS-SITE.XML_dfs.datanode.data.dir=/tmp/hadoop-root/dfs/data

# 2 DataNode -> moi block luu 2 ban
HDFS-SITE.XML_dfs.replication=2

# Block 64MB (mac dinh 128MB) de file vua phai cung chia thanh nhieu block,
# de thay ro co che phan tan tren HDFS UI
HDFS-SITE.XML_dfs.blocksize=67108864

# Tat kiem tra quyen de user 'jovyan' (Jupyter/Spark) ghi duoc vao HDFS
HDFS-SITE.XML_dfs.permissions.enabled=false

# Client (Spark) ket noi DataNode bang hostname thay vi IP noi bo
HDFS-SITE.XML_dfs.client.use.datanode.hostname=true
HDFS-SITE.XML_dfs.datanode.use.datanode.hostname=true

HADOOP_HEAPSIZE_MAX=768m
