# Bien moi truong dung chung (container jupyter, api, mongo-express doc file nay qua env_file).
# Cach dung: chep thanh .env roi dien mat khau:   cp .env.example .env
# .env KHONG dua len Git (.gitignore).
#
# Mat khau MongoDB phai trung voi MONGO_INITDB_ROOT_PASSWORD trong docker/docker-compose.yml
# (chi dat 1 lan khi volume mongodb con trong; doi sau do thi phai doi trong MongoDB).
HDFS_URL=hdfs://namenode:8020
SPARK_MASTER=spark://spark-master:7077
SPARK_DRIVER_HOST=jupyter
MONGO_URI=mongodb://admin:<MAT_KHAU_MONGODB>@mongodb:27017/?authSource=admin
MONGO_DB=vifood
PROJECT_DIR=/home/jovyan/work
# mongo-express (http://localhost:8090): tai khoan dang nhap trang web
ME_CONFIG_MONGODB_URL=mongodb://admin:<MAT_KHAU_MONGODB>@mongodb:27017/?authSource=admin
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=<MAT_KHAU_MONGO_EXPRESS>
